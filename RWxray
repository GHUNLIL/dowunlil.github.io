        "domain": [
          "geosite:category-cryptocurrency"
        ],
        "ruleTag": "加密货币",
        "outboundTag": "DIRECT"
      }
    ],
    "domainStrategy": "IPIfNonMatch"
  },
  "policy": {
    "levels": {
      "0": {
        "connIdle": 300,
        "handshake": 4,
        "bufferSize": 4,
        "uplinkOnly": 2,
        "downlinkOnly": 5
      }
    },
    "system": {
      "statsInboundUplink": false,
      "statsOutboundUplink": false,
      "statsInboundDownlink": false,
      "statsOutboundDownlink": false
    }
  }
}
